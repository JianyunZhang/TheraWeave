{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed genetic evidence import; not a GWAS or MR engine",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "reviewed", "reviewer", "synthetic", "records"],
  "properties": {
    "format": {"const": "theraweave.genetic-evidence"},
    "version": {"const": "0.1"},
    "reviewed": {"const": true},
    "reviewer": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "coverage_notes": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "entity_id", "namespace", "taxon_id", "context_id", "method", "mapping_basis", "allele_direction", "ancestry", "genome_build", "locus", "tissue", "endpoint", "stance", "limitations", "citations", "statement", "reviewed"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "entity_id": {"type": "string", "minLength": 1},
          "namespace": {"type": "string", "minLength": 1},
          "taxon_id": {"enum": [10090, 9606]},
          "context_id": {"type": ["string", "null"], "minLength": 1},
          "method": {"enum": ["gwas_association", "colocalization", "fine_mapping", "mendelian_randomization", "functional_variant"]},
          "mapping_basis": {"enum": ["nearest_gene", "coding_variant", "qtl_colocalization", "functional_assay", "reviewed_manual", "credible_set"]},
          "allele_direction": {"enum": ["inhibit", "activate", "restore", "unknown"]},
          "ancestry": {"type": "string", "minLength": 1},
          "genome_build": {"enum": ["GRCh38", "GRCm39", "GRCm38", "not_applicable"]},
          "locus": {"type": "string", "minLength": 1},
          "tissue": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1},
          "stance": {"enum": ["supports", "contradicts", "unclear"]},
          "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "citations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "statement": {"type": "string", "minLength": 1},
          "reviewed": {"type": "boolean"},
          "reviewer": {"type": ["string", "null"], "minLength": 1}
        }
      }
    }
  }
}
