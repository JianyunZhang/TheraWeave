{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate list; not an evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "synthetic", "context_id", "source_taxon_id", "disease_or_phenotype", "research_goal", "screening_rule", "source_note", "candidates"],
  "properties": {
    "format": {"const": "theraweave.candidate-list"},
    "version": {"const": "0.1"},
    "synthetic": {"type": "boolean"},
    "context_id": {"type": "string", "minLength": 1},
    "source_taxon_id": {"enum": [10090, 9606]},
    "disease_or_phenotype": {"type": "string", "minLength": 1},
    "research_goal": {"type": "string", "minLength": 1},
    "screening_rule": {"type": "string", "minLength": 1},
    "source_note": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "namespace", "entity_type", "taxon_id"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "namespace": {"type": "string", "minLength": 1},
          "entity_type": {"enum": ["gene", "transcript", "protein", "protein_group", "metabolite", "feature", "reaction"]},
          "taxon_id": {"enum": [10090, 9606]}
        }
      }
    }
  }
}
